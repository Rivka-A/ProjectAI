import os
import json
import requests
import time

# ==================== הגדרות ריצה ====================
START_OFFSET = 75      # מאיזו שורה בדאטהסט להתחיל לסרוק
TOTAL_TO_CHECK = 20    # סך כל השורות שברצונך לבדוק בסבב זה
ROWS_PER_REQUEST = 10  # כמה שורות למשוך בכל פנייה לשרת (מקסימום: 100)
OUTPUT_FOLDER = "poem" # שם התיקייה שבה יישמרו הקבצים המפוצלים
# ====================================================

# יצירת תיקיית היעד אם היא אינה קיימת
if not os.path.exists(OUTPUT_FOLDER):
    os.makedirs(OUTPUT_FOLDER)
    print(f"📁 התיקייה '{OUTPUT_FOLDER}' נוצרה בהצלחה!")

headers = {
    "User-Agent": "Mozilla/5.0"
}

def is_poetry(text):
    """ בדיקה ראשונית האם הטקסט הוא שיר לפי ממוצע מילים בשורה """
    if not text or not text.strip():
        return False
    lines = [line.strip() for line in text.split("\n") if line.strip()]
    if len(lines) < 3:
        return False
    total_words = sum(len(line.split()) for line in lines)
    average_words_per_line = total_words / len(lines)
    return average_words_per_line < 8

def parse_poem_to_stanzas(text):
    """ מנקה את הטקסט ומפצל אותו לבתים בצורה חכמה """
    all_lines = [line.strip() for line in text.split("\n")]
    
    clean_lines = []
    for line in all_lines:
        # סינון שורות ריקות וסינון קרדיטים של פרויקט בן יהודה בסוף
        if not line or "את הטקסט[ים] לעיל הפיקו" in line or "https://" in line:
            continue
        # סינון הערות שוליים בסוגריים (כמו אסף ל"ז נ')
        if line.startswith("(") and line.endswith(")"):
            continue
        clean_lines.append(line)
        
    if not clean_lines:
        return "Untitled", []

    # השורה הראשונה מוגדרת ככותרת, השאר הם גוף השיר
    title = clean_lines[0]
    poem_body_lines = clean_lines[1:]
    
    stanzas = []
    current_stanza = []
    
    # חלוקה לבתים לפי נקודות בסוף משפט או הגעה ל-6 שורות
    for line in poem_body_lines:
        current_stanza.append(line)
        
        # תנאי סגירת בית: סוף משפט (נקודה/סימן קריאה) או בית שהגיע ל-6 שורות
        if line.endswith(".") or line.endswith("!") or line.endswith("?") or len(current_stanza) >= 6:
            stanzas.append(current_stanza)
            current_stanza = []
            
    # אם נשארו שורות בסוף, נכניס אותן כבית האחרון
    if current_stanza:
        stanzas.append(current_stanza)
        
    return title, stanzas

# --- תחילת תהליך הריצה המרכזי ---
saved_count = 0
current_offset = START_OFFSET

print(f"\n=== תחילת ריצה: סורק {TOTAL_TO_CHECK} שורות החל משורה {START_OFFSET} ===\n")

while current_offset < START_OFFSET + TOTAL_TO_CHECK:
    
    url = f"https://datasets-server.huggingface.co/rows?dataset=NHLOCAL/project-ben-yehuda&config=default&split=train&offset={current_offset}&limit={ROWS_PER_REQUEST}"
    
    try:
        print(f"🔄 מושך שורות {current_offset} עד {current_offset + ROWS_PER_REQUEST}...")
        response = requests.get(url, headers=headers, timeout=20)
        response.raise_for_status()
        
        data = response.json()
        rows = data.get("rows", [])
        
        if not rows:
            print("הגענו לסוף הדאטהסט (אין יותר שורות).")
            break
            
        for row_item in rows:
            row_id = row_item.get("row_idx")
            full_text = row_item.get("row", {}).get("text", "")
            
            # 1. סינון: אם זה לא שיר, נדלג מייד
            if not is_poetry(full_text):
                continue
                
            # 2. עיבוד: נקה את השיר ונפצל אותו לבתים
            title, stanzas = parse_poem_to_stanzas(full_text)
            
            # 3. בניית אובייקט ה-JSON החדש
            poem_data = {
                "row_index": row_id,
                "title": title,
                "detected_genre": "poetry",
                "total_stanzas": len(stanzas),
                "stanzas": stanzas
            }
            
            # 4. שמירה לקובץ נפרד בתוך התיקייה
            file_path = os.path.join(OUTPUT_FOLDER, f"poem_row_{row_id}.json")
            with open(file_path, "w", encoding="utf-8") as f:
                json.dump(poem_data, f, ensure_ascii=False, indent=2)
                
            saved_count += 1
            print(f"  🎵 שיר {row_id} עובד ונשמר: '{title}' ({len(stanzas)} בתים)")

    except Exception as e:
        print(f"✗ שגיאה ב-offset {current_offset}: {e}")
        
    current_offset += ROWS_PER_REQUEST
    time.sleep(1) # השהייה של שנייה בין בקשות כדי לשמור על יציבות מול השרת

print(f"\n=== הסתיים בהצלחה! {saved_count} שירים פוצלו ונשמרו בתוך התיקייה '{OUTPUT_FOLDER}'. ===")
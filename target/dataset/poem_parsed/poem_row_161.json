{
  "row_index": 161,
  "title": "עציץ פרחים",
  "detected_genre": "poetry",
  "total_stanzas": 2,
  "stanzas": [
    [
      "מִן הַחַלּוֹן",
      "פֶּרַח עָצִיץ",
      "כָּל-הַיּוֹם",
      "הַגַּנָּה יָצִיץ."
    ],
    [
      "כָּל חֲבֵרָיו –",
      "שָׁם בַּגָּן,",
      "הוּא לְבַדּוֹ",
      "עוֹמֵד כָּאן."
    ]
  ]
}
{
  "row_index": 255,
  "title": "בשנת ויתר עז",
  "detected_genre": "poetry",
  "total_stanzas": 5,
  "stanzas": [
   
    [
      "הָמָן נָפָל,2",
      "הַנֵּס נִכְפָּל,",
      "וּבְיוֹם פּוּרִים",
      "הָרֹאשׁ נָרִים."
    ],
    [
      "כִּי הַדַּרְשָׁן",
      "כִּדְמוּת כּוּשָׁן",
      "דּוֹרֵשׁ רָעָה,",
      "אוֹתָהּ שָׁעָה",
      "רֶשֶׁת טָמַן",
      "אֶל עַם נִבְחָר,"
    ],
    [
      "וּכְמוֹ הָמָן",
      "אֶל יוֹם מָחָר",
      "גָּרוֹן נִחַר",
      "חָלָה נִפְגָּר",
      "מָוֶת אָגַר",
      "כָּל רִשְׁעָתוֹ:"
    ],
    [
      "אֶל אֵל נוֹדֶה",
      "כִּי הוּא פּוֹדֶה",
      "גוֹאֵל עַמּוֹ",
      "כָּבוֹד לִשְׁמוֹ:",
      "שם הכומר הזה הוא Padre (conte) Nuvoli. &nbsp;↩︎",
      "שיר פשוט ומשקלו ה' הברות אבל החרוזים אינם מדויקים כראוי. &nbsp;↩︎"
    ]
  ]
}